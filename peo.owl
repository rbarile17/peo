    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#constraintValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#constraintValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Constraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#modelFamily -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#modelFamily">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#operator -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#operator">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Constraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#parametersNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#parametersNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Architecture"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#releaseYear -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#releaseYear">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#supportedDataModality -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#supportedDataModality">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#dataModality"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#targetDataModality -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#targetDataModality">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Task"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#dataModality"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#variable -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#variable">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Constraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


