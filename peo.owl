    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Architecture -->

    <owl:Class rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Architecture">
