<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11/"
     xml:base="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:untitled-ontology-11="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11">
        <rdfs:comment>https://creativecommons.org/licenses/by/4.0/</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#dataModality -->

    <rdfs:Datatype rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#dataModality">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>audio</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>code</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>image</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>natural language</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>video</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#adoptsSuitableTechniqueFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#adoptsSuitableTechniqueFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Prompt"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Task"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isAdoptedIn"/>
            </rdf:Description>
            <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isConsideredSuitableFor"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#directlyFollows -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#directlyFollows">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#follows"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Prompt"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Prompt"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#follows -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#follows">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Prompt"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Prompt"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasArchitecture -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasArchitecture">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Architecture"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasConstraint -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasConstraint">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Task"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Constraint"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasEvolution -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasEvolution">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasEvolutionAncestor"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasVariant"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasEvolutionAncestor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasEvolutionAncestor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasFirstPrompt -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasFirstPrompt">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasMessage"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Chat"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Prompt"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasMessage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasMessage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Chat"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Prompt"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasMessage"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#follows"/>
            </rdf:Description>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasVariant -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasVariant">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasVariantAncestor"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasVariantAncestor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasVariantAncestor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isAdoptedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isAdoptedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#PromptingTechnique"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Prompt"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isConsideredSuitableFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isConsideredSuitableFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#PromptingTechnique"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Task"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isHeldWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isHeldWith">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Chat"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isInChatTargeting -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isInChatTargeting">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Prompt"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Task"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasMessage"/>
            </rdf:Description>
            <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#targets"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isInChatWithFoundationModel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isInChatWithFoundationModel">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Prompt"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#FoundationModel"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#hasMessage"/>
            </rdf:Description>
            <rdf:Description rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#isHeldWith"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#targets -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#targets">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Chat"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/robertobarile/ontologies/2026/4/untitled-ontology-11#Task"/>
    </owl:ObjectProperty>
    


